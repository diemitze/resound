<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ResoundServer</RootNamespace>
    <AssemblyName>Resound.Server</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>1.2.0</Version>
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.0" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.0" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.1.0" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0" />
    <PackageReference Include="SPTarkov.Server.Web" Version="4.1.0" />
  </ItemGroup>

  <!-- Deploys to the local SPT install. Warns rather than fails while the running server holds the DLL. -->
  <Target Name="DeployToSpt" AfterTargets="Build" Condition="Exists('D:\SPT 4.1 dev\SPT_Runtime\user\mods')">
    <MakeDir Directories="D:\SPT 4.1 dev\SPT_Runtime\user\mods\Resound.Server" />
    <Exec Command="xcopy /E /I /Y &quot;$(ProjectDir)$(OutputPath)*&quot; &quot;D:\SPT 4.1 dev\SPT_Runtime\user\mods\Resound.Server&quot;"
          ContinueOnError="WarnAndContinue" />
    <Warning Text="Could not deploy to SPT: close the SPT server and rebuild." Condition="'$(MSBuildLastTaskResult)' == 'false'" />
  </Target>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

</Project>
