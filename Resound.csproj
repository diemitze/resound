<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- JSON DTO fields are assigned by the deserializer, which the compiler cannot see. -->
    <NoWarn>$(NoWarn);0649</NoWarn>
    <AssemblyName>Resound</AssemblyName>
    <RootNamespace>Resound</RootNamespace>
    <Nullable>disable</Nullable>
    <Authors>20fpsguy</Authors>
    <AssemblyVersion>1.2.0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Configurations>Debug;Release</Configurations>
    <Version>$(AssemblyVersion)</Version>
    <LangVersion>latest</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>D:\SPT 4.1 dev\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>D:\SPT 4.1 dev\BepInEx\plugins\spt\spt-common.dll</HintPath>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>D:\SPT 4.1 dev\BepInEx\plugins\spt\spt-reflection.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>D:\SPT 4.1 dev\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>D:\SPT 4.1 dev\BepInEx\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>D:\SPT 4.1 dev\EscapeFromTarkov_Data\Managed\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>D:\SPT 4.1 dev\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>D:\SPT 4.1 dev\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>D:\SPT 4.1 dev\EscapeFromTarkov_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="sounds\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The default glob would pull in the server, tests and example/; none belong here. -->
  <ItemGroup>
    <Compile Remove="Server\**" />
    <None Remove="Server\**" />
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Compile Remove="example\**" />
    <None Remove="example\**" />
  </ItemGroup>

  <!-- Deploys to the local SPT install when it exists. -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="Exists('D:\SPT 4.1 dev\BepInEx\plugins')">
    <PropertyGroup>
      <DeployDir>D:\SPT 4.1 dev\BepInEx\plugins</DeployDir>
      <DeploySounds>$(DeployDir)\Resound\sounds</DeploySounds>
    </PropertyGroup>
    <ItemGroup>
      <!-- Not mapping.json: the deployed copy is edited in place and must survive a build. -->
      <DeployAudio Include="$(ProjectDir)sounds\**\*.*" Exclude="$(ProjectDir)sounds\mapping.json" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
    <MakeDir Directories="$(DeploySounds)" />
    <Copy SourceFiles="@(DeployAudio)" DestinationFolder="$(DeploySounds)\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)sounds\mapping.json" DestinationFolder="$(DeploySounds)"
          Condition="!Exists('$(DeploySounds)\mapping.json')" />
    <Message Importance="high" Condition="Exists('$(DeploySounds)\mapping.json')"
             Text="Resound: kept the mapping.json already in $(DeploySounds)." />
  </Target>

  <Target Name="PackageModForDistribution" AfterTargets="Build">
    <PropertyGroup>
      <ModName>$(AssemblyName)</ModName>
      <ZipFileName>$(ModName).zip</ZipFileName>
      <TempPackageDir>$(ProjectDir)obj\Package</TempPackageDir>
      <ModPackageDir>$(TempPackageDir)\BepInEx\plugins</ModPackageDir>
      <!-- Always Release, so no pdb or web asset manifests end up in the download. -->
      <ServerBuildDir>$(ProjectDir)Server\bin\Release\Resound.Server</ServerBuildDir>
      <ServerPackageDir>$(TempPackageDir)\SPT_Runtime\user\mods\Resound.Server</ServerPackageDir>
    </PropertyGroup>
    <ItemGroup>
      <SoundFiles Include="$(ProjectDir)sounds\**\*.*" />
    </ItemGroup>
    <Message Text="--- Starting Mod packaging for distribution ---" Importance="high" />
    <RemoveDir Directories="$(TempPackageDir)" />
    <MakeDir Directories="$(ModPackageDir)\Resound" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModPackageDir)" />
    <Copy SourceFiles="@(SoundFiles)"
          DestinationFolder="$(ModPackageDir)\Resound\sounds\%(RecursiveDir)" />

    <!-- Built here, not referenced (different framework). Failing must not cost the client zip. -->
    <MSBuild Projects="$(ProjectDir)Server\Resound.Server.csproj" Targets="Build"
             Properties="Configuration=Release" ContinueOnError="WarnAndContinue" />
    <ItemGroup>
      <ServerFiles Include="$(ServerBuildDir)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ServerFiles)" DestinationFolder="$(ServerPackageDir)\%(RecursiveDir)" />
    <Warning Text="Server half not packaged: no build output in $(ServerBuildDir)."
             Condition="'@(ServerFiles)' == ''" />

    <!-- Pack tools in their own folder, so extracting into SPT drops nothing in its root. -->
    <ItemGroup>
      <PackTools Include="$(ProjectDir)make_pack.ps1" />
      <PackTools Include="$(ProjectDir)example-pack\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PackTools)" DestinationFolder="$(TempPackageDir)\Resound-pack-tools\%(RecursiveDir)" />

    <ZipDirectory SourceDirectory="$(TempPackageDir)" DestinationFile="$(ProjectDir)$(ZipFileName)" Overwrite="true" />
    <RemoveDir Directories="$(TempPackageDir)" />
    <Message Text="--- Mod packaged: $(ProjectDir)$(ZipFileName) (@(SoundFiles->Count()) sound file(s), @(ServerFiles->Count()) server file(s)) ---" Importance="high" />
  </Target>

</Project>

